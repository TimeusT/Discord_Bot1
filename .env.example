# Copy this file to ".env" and fill in the values. Never share or commit ".env".

# --- Required ---
# Bot token from the Discord Developer Portal (Bot tab -> Reset Token)
DISCORD_TOKEN=
# Channel(s) the bot listens to. Separate several IDs with commas.
DISCORD_CHANNEL_IDS=
# Key from https://console.anthropic.com (used to read the post and write the summary)
ANTHROPIC_API_KEY=

# --- Optional (defaults shown) ---
ANTHROPIC_MODEL=claude-haiku-5-5
# Speech-to-text size: tiny, base, small, medium. Bigger = more accurate but slower.
WHISPER_MODEL=base
# Path to an exported Instagram cookies file, only needed if Instagram blocks the bot.
INSTAGRAM_COOKIES_FILE=
